{
  "protocol_parameters": {
    "I2C": {
      "type": "wired",
      "clock_standard": 100000,
      "clock_fast": 400000,
      "bits_per_byte": 9,
      "start_bits": 1,
      "stop_bits": 1,
      "address_bits": 7,
      "tx_current_ma": 0.5,
      "source": "I2C Specification NXP UM10204, Section 3.1"
    },
    "SPI": {
      "type": "wired",
      "clock_max": 10000000,
      "bits_per_byte": 8,
      "tx_current_ma": 2.0,
      "source": "SPI Specification Motorola, Section 2.1"
    },
    "UART": {
      "type": "wired",
      "baud_rate": 115200,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "bits_per_byte": 10,
      "tx_current_ma": 1.5,
      "source": "UART 16550 Datasheet, Section 3.2"
    },
    "CAN": {
      "type": "wired",
      "bit_rate": 1000000,
      "max_data_bytes": 8,
      "overhead_bits": 47,
      "tx_current_ma": 3.0,
      "source": "CAN 2.0 Specification Bosch, Section 4.1"
    },
    "WiFi": {
      "type": "wireless",
      "phy_rate_mbps": 54,
      "header_bits": 192,
      "preamble_us": 16,
      "sifs_us": 10,
      "difs_us": 34,
      "tx_current_ma": 240,
      "rx_current_ma": 70,
      "idle_current_ma": 15,
      "sleep_current_ma": 0.01,
      "voltage_v": 3.3,
      "retry_limit": 7,
      "source": "ESP32 Datasheet Espressif, Section 2.4"
    },
    "BLE": {
      "type": "wireless",
      "phy_rate_mbps": 1,
      "preamble_bits": 8,
      "access_address_bits": 32,
      "header_bits": 8,
      "crc_bits": 24,
      "max_payload_bytes": 20,
      "tx_current_ma": 15,
      "rx_current_ma": 13,
      "sleep_current_ma": 0.01,
      "voltage_v": 3.3,
      "retry_limit": 3,
      "source": "nRF52832 Datasheet Nordic, Section 6.1"
    },
    "Zigbee": {
      "type": "wireless",
      "phy_rate_kbps": 250,
      "phy_header_bits": 6,
      "mac_header_bits": 104,
      "max_frame_bytes": 127,
      "tx_current_ma": 25,
      "rx_current_ma": 20,
      "sleep_current_ma": 0.001,
      "voltage_v": 3.3,
      "retry_limit": 4,
      "source": "IEEE 802.15.4 Standard, Section 6.2"
    },
    "LoRa": {
      "type": "wireless",
      "bandwidth_khz": 125,
      "spreading_factor": 7,
      "coding_rate": 1,
      "preamble_symbols": 8,
      "tx_current_ma": 120,
      "rx_current_ma": 12,
      "sleep_current_ma": 0.001,
      "voltage_v": 3.3,
      "retry_limit": 3,
      "duty_cycle_percent": 1,
      "source": "SX1276 Datasheet Semtech, Section 4.1.1"
    },
    "MQTT": {
      "type": "application",
      "fixed_header_bytes": 2,
      "topic_length_bytes": 2,
      "tcp_ip_overhead_bytes": 40,
      "source": "MQTT 3.1.1 Specification, Section 2.1"
    },
    "CoAP": {
      "type": "application",
      "header_bytes": 4,
      "token_bytes": 4,
      "udp_ip_overhead_bytes": 28,
      "ack_timeout_s": 2,
      "ack_random_factor": 1.5,
      "max_retransmit": 4,
      "source": "RFC 7252, Section 4.2"
    }
